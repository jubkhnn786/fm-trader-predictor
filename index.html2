<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PREDICTOR MINI APP</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Courier New', Courier, monospace;
        }

        body {
            background-color: #050505;
            color: #00ff66;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
        }

        .container {
            width: 100%;
            max-width: 400px;
            padding: 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }

        /* Top Skull Animation */
        .avatar-box {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: radial-gradient(circle, #00ff6633 0%, #000000 70%);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 50px;
            box-shadow: 0 0 25px #00ff6666;
            animation: pulseGlow 2s infinite alternate;
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 15px #00ff6644; transform: scale(0.98); }
            100% { box-shadow: 0 0 35px #00ff66aa; transform: scale(1.05); }
        }

        /* Text Styles & Animations */
        .badge {
            border: 1px solid #00ff66;
            padding: 6px 16px;
            font-size: 14px;
            letter-spacing: 2px;
            box-shadow: 0 0 10px #00ff6644;
        }

        .title {
            font-size: 32px;
            font-weight: 900;
            color: #00ff66;
            text-shadow: 0 0 12px #00ff66;
            letter-spacing: 3px;
            margin-top: 5px;
        }

        .version-num {
            color: #ff3333;
            font-size: 36px;
            text-shadow: 0 0 12px #ff3333;
            margin-bottom: 5px;
        }

        .subtitle {
            font-size: 11px;
            color: #888;
            letter-spacing: 2px;
            line-height: 1.5;
        }

        .status-box {
            border: 1px solid #00ff66;
            padding: 10px 20px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 14px;
            letter-spacing: 2px;
            box-shadow: 0 0 10px #00ff6633;
        }

        .dot {
            width: 8px;
            height: 8px;
            background-color: #00ff66;
            border-radius: 50%;
            box-shadow: 0 0 8px #00ff66;
            animation: blink 1s infinite alternate;
        }

        @keyframes blink {
            from { opacity: 0.2; }
            to { opacity: 1; }
        }

        /* Buttons */
        .btn {
            width: 100%;
            padding: 14px;
            background: transparent;
            border: 1px solid #00ff66;
            color: #00ff66;
            font-size: 16px;
            font-weight: bold;
            letter-spacing: 2px;
            cursor: pointer;
            box-shadow: 0 0 10px #00ff6644;
            transition: all 0.2s ease;
            text-decoration: none;
            display: block;
        }

        .btn:active {
            background-color: #00ff6622;
            transform: scale(0.98);
        }

        /* Popup Overlay for Key Activation */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .modal {
            background: #0a0a0a;
            border: 1px solid #00ff66;
            padding: 20px;
            width: 100%;
            max-width: 320px;
            text-align: center;
            box-shadow: 0 0 20px #00ff6666;
        }

        .modal input {
            width: 100%;
            padding: 10px;
            margin: 15px 0;
            background: #000;
            border: 1px solid #00ff66;
            color: #00ff66;
            text-align: center;
            font-size: 16px;
            outline: none;
        }

        .modal-btn-group {
            display: flex;
            gap: 10px;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="avatar-box">💀</div>
        <div class="badge">◆ VERSION 4.0 ◆</div>
        
        <div class="title">PREDICTOR</div>
        <div class="version-num">4.0</div>
        
        <div class="subtitle">ALL GAMES CONNECTED · DIRECT API SERVER</div>
        
        <div class="status-box">
            <div class="dot"></div>
            <span>SYSTEM ONLINE</span>
        </div>

        <!-- Action Buttons -->
        <button class="btn" onclick="openKeyModal()">ACTIVATE ▶</button>
        <a href="https://t.me@FMTrader09" target="_blank" class="btn">BUY KEY 🔑</a>
        <a href="https://t.me/https://t.me/+bs9Ys0z9arY5MmJltarget="_blank" class="btn">JOIN CHANNEL 📢</a>
    </div>

    <!-- Key Validation Popup -->
    <div class="modal-overlay" id="keyModal">
        <div class="modal">
            <h3>ENTER ACTIVATION KEY</h3>
            <input type="text" id="keyInput" placeholder="Paste Key Here">
            <div class="modal-btn-group">
                <button class="btn" onclick="submitKey()">SUBMIT</button>
                <button class="btn" style="border-color:#ff3333; color:#ff3333;" onclick="closeKeyModal()">CANCEL</button>
            </div>
        </div>
    </div>

    <script>
        function openKeyModal() {
            document.getElementById('keyModal').style.display = 'flex';
        }

        function closeKeyModal() {
            document.getElementById('keyModal').style.display = 'none';
        }

        function submitKey() {
            const userKey = document.getElementById('keyInput').value;
            
            if (userKey.trim() === "") {
                alert("Kripya Key enter karein!");
                return;
            }

            // Kisi bhi key par Telegram Username par redirect karne ke liye:
            alert("Validating Key...");
            window.location.href = "https://t.me/YOUR_TELEGRAM_USERNAME";
        }
    </script>
</body>
</html>
